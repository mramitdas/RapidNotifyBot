# RapidNotify v2 configuration — copy to .env and fill in real values.
# Never commit .env.

# PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://rapid:rapid@localhost:5432/rapidnotify

# Telegram Bot API token (@BotFather)
BOT_TOKEN=changeme

# Random pepper used to hash API keys and registration tokens (>=32 chars)
KEY_PEPPER=changeme-32-byte-min-random-string

# Rate limit: max requests per window per API key
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Max size of notification data JSON, bytes
MAX_PAYLOAD_BYTES=8192

# Optional: log level (INFO, DEBUG, ...)
LOG_LEVEL=INFO
